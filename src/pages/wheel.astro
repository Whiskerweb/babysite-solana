---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Divider from '../components/Divider.astro';
import Usdc from '../components/Usdc.astro';
import T from '../components/T.astro';
import { GAME_URL, BABY_BUY_URL, wheel } from '../data/site';

// ============================================================
//  /wheel — the welcome wheel, explained.
//
//  Everything numeric on this page is read from `wheel` in site.ts: the
//  table prints it, the disc is drawn from it, the average is quoted from it.
//  A page about published odds cannot afford two copies of the odds.
// ============================================================

const slices = wheel.slices;
const top = Math.max(...slices.map((s) => s.pct));

// The bars. A linear scale makes everything under 5% a hairline and a log
// scale makes 70% and 0.0001% look like neighbours; the square root keeps the
// order visible without lying about the gap. The exact figure is printed on
// every row, the bar only ranks them.
const rows = slices.map((s) => ({
  ...s,
  width: Math.sqrt(s.pct / top) * 100,
  amount: s.usdc.toLocaleString('en-US'),
}));

// The disc, TO SCALE. Each slice takes exactly its share of the 360 degrees,
// so the 1,000 slice is 0.00036 of a degree: thinner than any line a screen
// can draw. It is marked by a hairline instead, and the caption says so.
// The same rule the game's own payout wheel lives by: a slice's size is its
// probability, and only its position is free.
const paint: Record<number, string> = {
  0:    'rgba(20,10,50,.34)',
  1:    'rgba(255,255,255,.34)',
  2:    'rgba(255,255,255,.6)',
  5:    '#FFE27A',
  10:   '#FFC93C',
  100:  '#F0A017',
  200:  '#FF7FB0',
  1000: '#F0538F',
};
// Turned so the hairline sits at ten o'clock and the pointer at the top reads
// over the biggest slice: a pointer parked on the jackpot would be a promise.
const FROM = -60;
let acc = 0;
const stops = slices.map((s) => {
  const a = acc;
  acc += (s.pct / 100) * 360;
  return `${paint[s.usdc]} ${a.toFixed(4)}deg ${acc.toFixed(4)}deg`;
});
const gradient = `conic-gradient(from ${FROM}deg, ${stops.join(', ')})`;

// Labels inside the disc, placed at the middle of their slice. Only the
// three slices wide enough to carry a word; the rest is the table's job.
const label = (usdc: number) => {
  let start = 0;
  for (const s of slices) {
    if (s.usdc === usdc) {
      const mid = ((start + (s.pct / 100) * 360 / 2 + FROM) * Math.PI) / 180;
      const r = usdc === 0 ? 30 : 34;
      return `left:${(50 + r * Math.sin(mid)).toFixed(1)}%; top:${(50 - r * Math.cos(mid)).toFixed(1)}%`;
    }
    start += (s.pct / 100) * 360;
  }
  return '';
};

const steps = [
  { n: '01', title: 'Sign in',   text: 'With an email, or your Solana wallet — Phantom, Solflare, Backpack.' },
  { n: '02', title: 'Deposit',   text: `${wheel.minDeposit} {USDC} or more, into your game wallet.` },
  { n: '03', title: 'Finish one match', text: 'Any mode: a duel, a squad, an arena. Finishing is what counts, not winning.' },
  { n: '04', title: 'Spin',      text: 'Whatever lands is credited to your game balance. Withdraw any time.' },
];

const fine = [
  'One spin per account.',
  'The seed is drawn cryptographically, the same way as the payout wheel.',
  'Real money: play where it is legal for you.',
];
---
<Layout
  title="The 1,000 USDC Wheel · Baby Guy"
  description="Finish your first match on Baby Guy, spin once, and walk away with up to 1,000 USDC. Fixed, published odds: most spins pay nothing, 1, 2 and 5 USDC land often, and one slice in a million pays 1,000."
>
  <Header />
  <main>

    <!-- ============================================================
         1. THE CLAIM. Copy on the left, the wheel drawn to scale on the
         right. Two buttons: gold goes to the game, as everywhere on the
         site; the token is a ghost next to it, never a second gold.
         ============================================================ -->
    <section class="section top" id="top">
      <div class="wrap top__grid">
        <div class="top__copy">
          <p class="eyebrow">Welcome wheel</p>
          <h1 class="top__title">The 1,000 USDC Wheel</h1>
          <p class="top__sub">
            Finish your first match. Spin once. Walk away with up to
            <strong class="top__max">1,000<Usdc /></strong>
          </p>
          <p class="lede top__lede">
            Most spins pay nothing. That is the honest part. But 1, 2 and 5 <Usdc />
            land often enough to matter, and one slice in a million pays 1,000. The
            odds are fixed, published here, and printed on the wheel itself.
          </p>
          <div class="top__actions">
            <a class="btn btn--gold btn--lg" href={GAME_URL}>Play now</a>
{BABY_BUY_URL && (
            <a class="btn btn--ghost btn--md" href={BABY_BUY_URL} rel="noopener" target="_blank">
              Buy $BABY
              <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"
                      stroke-linejoin="round" d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
              </svg>
            </a>
            )}
          </div>
        </div>

        <figure class="wheel" aria-labelledby="wheel-cap">
          <div class="wheel__stage">
            <span class="wheel__pointer" aria-hidden="true"></span>
            <div
              class="wheel__disc"
              role="img"
              aria-label={`The wheel drawn to scale: ${slices.map((s) => `${s.label} pays ${s.usdc} USDC`).join(', ')}.`}
              style={`background:${gradient}`}
            >
              <!-- The 1,000 slice, as a line: at 0.00036 of a degree it has no width to draw. -->
              <span class="wheel__hair" style={`transform:rotate(${FROM}deg)`} aria-hidden="true"></span>
              <span class="wheel__hub" aria-hidden="true"></span>
              <span class="wheel__lbl wheel__lbl--none" style={label(0)} aria-hidden="true">
                <b>70%</b><i>nothing</i>
              </span>
              <span class="wheel__lbl" style={label(1)} aria-hidden="true"><b>15%</b><i>1</i></span>
              <span class="wheel__lbl" style={label(2)} aria-hidden="true"><b>9%</b><i>2</i></span>
            </div>
          </div>
          <figcaption class="wheel__cap" id="wheel-cap">
            Drawn to scale. The 1,000 slice is one in a million: thinner than the
            pink line that marks it.
          </figcaption>
          <ul class="wheel__key" aria-hidden="true">
            {slices.map((s) => (
              <li>
                <span class={`wheel__sw ${s.usdc === 1000 ? 'is-hair' : ''}`} style={`background:${paint[s.usdc]}`}></span>
                {s.usdc === 0 ? 'nothing' : s.usdc.toLocaleString('en-US')}
              </li>
            ))}
          </ul>
        </figure>
      </div>
    </section>

    <!-- ============================================================
         2. THE ODDS. Eight rows, every figure exact. The 0 row says 70%
         large and 69.9999% small: the first is what a reader takes
         away, the second is what the wheel is actually cut to.
         ============================================================ -->
    <section class="section odds" id="odds">
      <Divider dir="right" color="var(--violet)" />
      <div class="wrap">
        <p class="eyebrow">The odds</p>
        <h2 class="h2">Eight slices, printed in full.</h2>
        <p class="lede odds__lede">
          What one spin can land on, and how often. These are the numbers the
          wheel is cut to, not a rounding of them.
        </p>

        <div class="table" role="table" aria-label="Odds of the welcome wheel">
          <div class="table__head" role="row">
            <span role="columnheader">Lands on</span>
            <span role="columnheader" class="table__head-bar">How often</span>
            <span role="columnheader" class="table__head-pct">Odds</span>
          </div>
          {rows.map((r) => (
            <div class={`row ${r.usdc === 0 ? 'is-none' : ''} ${r.usdc === 1000 ? 'is-jackpot' : ''}`} role="row">
              <p class="row__amt" role="cell">
                <span class="row__num">{r.amount}<Usdc /></span>
                {r.note && <span class="row__note">{r.note}</span>}
              </p>
              <div class="row__track" role="cell" aria-hidden="true">
                <span class="row__bar" style={`--w:${r.width.toFixed(2)}%; --c:${paint[r.usdc]}`}></span>
              </div>
              <p class="row__pct" role="cell">
                {r.big ? (
                  <>
                    <span class="row__big">{r.big}</span>
                    <span class="row__exact">{r.label}</span>
                  </>
                ) : (
                  <span class="row__big">{r.label}</span>
                )}
              </p>
            </div>
          ))}
        </div>

        <p class="odds__foot">
          <strong>Odds add up to 100%.</strong>
          <span class="odds__sep" aria-hidden="true">·</span>
          <span>Average spin: <strong>{wheel.average}<Usdc /></strong></span>
        </p>
        <p class="odds__scale">
          Bars are on a square-root scale so the rare slices stay visible. The percentages are exact.
        </p>
      </div>
    </section>

    <!-- ============================================================
         3. HOW IT WORKS. Numerals on a rail, the home page's idiom for
         steps. Then the rollout note: the page goes live before the
         wheel does, and a player must not think they have missed it.
         ============================================================ -->
    <section class="section how" id="how">
      <Divider dir="left" color="var(--sky)" />
      <div class="wrap">
        <p class="eyebrow">How it works</p>
        <h2 class="h2">Four steps, one spin.</h2>

        <ol class="steps">
          {steps.map((s) => (
            <li class="step">
              <span class="step__n" aria-hidden="true">{s.n}</span>
              <h3 class="step__t">{s.title}</h3>
              <p class="step__x"><T text={s.text} /></p>
            </li>
          ))}
        </ol>

        <div class="rollout">
          <div class="rollout__txt">
            <p class="rollout__t">Play now, spin when it lands</p>
            <p class="rollout__x">
              The wheel is rolling out on play.babyguy.xyz. Your first finished match
              counts from today: if you play before the wheel is live, your spin is
              waiting for you.
            </p>
          </div>
          <a class="btn btn--gold btn--md rollout__cta" href={GAME_URL}>Play now</a>
        </div>
      </div>
    </section>

    <!-- ============================================================
         4. THE FREE SKIN, then the fine print. Same stock as the home
         page's closing card: the character breaks out of the frame, the
         glow behind him is the section's own pink and gold.
         ============================================================ -->
    <section class="section skin" id="skin">
      <Divider dir="right" color="var(--violet)" />
      <div class="wrap">
        <div class="card">
          <figure class="char">
            <span class="char__glow" aria-hidden="true"></span>
            <span class="char__flash">Free</span>
            <!-- The game's own catalogue portrait of BabyTrump (512 px). Swap the
                 file for the final key art when it arrives; the frame is 1:1. -->
            <img
              class="char__img"
              src="/img/babytrump.webp"
              alt="BabyTrump, as a playable character"
              width="512" height="512"
              loading="lazy" decoding="async"
            />
          </figure>

          <div class="card__body">
            <p class="eyebrow">Free skin</p>
            <h2 class="card__t">BabyTrump is free.</h2>
            <p class="card__x">
              Sign in, share BabyGuy on X from the shop, and wear him.
            </p>
            <a class="btn btn--gold btn--lg card__cta" href={GAME_URL}>Play now</a>
            <p class="form-note">Opens play.babyguy.xyz. 18+.</p>
          </div>
        </div>

        <ul class="fine">
          {fine.map((f) => <li>{f}</li>)}
        </ul>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  /* ============================================================
     1. THE CLAIM
     ============================================================ */
  .top{
    background:
      radial-gradient(760px 520px at 78% 40%, rgba(255,201,60,.13), transparent 62%),
      var(--violet-900);
    /* The header's curve lays over the top of this section: clear it. */
    padding-top: clamp(84px, 11vw, 150px);
  }
  .top__grid{
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .top__title{
    font-size: clamp(34px, 5.6vw, 70px);
    text-transform: uppercase;
    letter-spacing: -1.5px;
    line-height: .98;
    text-wrap: balance;
  }
  .top__sub{
    margin-top: 18px;
    font-size: clamp(17px, 2vw, 24px);
    font-weight: 800;
    line-height: 1.35;
    max-width: 30ch;
  }
  .top__max{
    color: var(--gold);
    font-weight: 900;
    white-space: nowrap;
    text-shadow: 0 6px 30px rgba(255,201,60,.28);
  }
  .top__max :global(.usdc){ vertical-align: -.12em; }
  .top__lede{ margin-top: 18px; color: rgba(255,255,255,.88); max-width: 52ch; }
  .top__actions{
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 18px;
    margin-top: clamp(24px, 3vw, 34px);
  }
  .top__actions .btn--ghost svg{ margin-left: -2px; }

  /* --- The disc --- */
  .wheel{ margin: 0; display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .wheel__stage{
    position: relative;
    width: min(100%, 440px);
    aspect-ratio: 1;
    padding-top: 18px;   /* room for the pointer */
  }
  .wheel__pointer{
    position: absolute;
    left: 50%; top: 0;
    z-index: 3;
    width: 0; height: 0;
    transform: translateX(-50%);
    border-left: 13px solid transparent;
    border-right: 13px solid transparent;
    border-top: 26px solid var(--gold);
    filter: drop-shadow(0 3px 6px rgba(0,0,0,.35));
  }
  .wheel__disc{
    position: relative;
    width: 100%;
    height: calc(100% - 18px);
    border-radius: 50%;
    /* Same rim as the pot bar on the home page. */
    border: 3px solid rgba(255,255,255,.9);
    box-shadow:
      inset 0 0 0 6px rgba(20,10,50,.25),
      0 18px 48px rgba(20,10,50,.42);
  }
  .wheel__hair{
    position: absolute;
    left: calc(50% - 1px);
    top: 0;
    width: 2px;
    height: 50%;
    transform-origin: 50% 100%;
    background: #F0538F;
    box-shadow: 0 0 6px rgba(240,83,143,.8);
  }
  .wheel__hub{
    position: absolute;
    left: 50%; top: 50%;
    width: 14%; height: 14%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: linear-gradient(180deg, var(--gold-lite) 0%, var(--gold) 52%, var(--gold-deep) 100%);
    border: 3px solid rgba(255,255,255,.9);
    box-shadow: inset 0 2px 0 rgba(255,255,255,.6), 0 4px 12px rgba(0,0,0,.35);
  }
  .wheel__lbl{
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    text-shadow: 0 1px 4px rgba(0,0,0,.4);
  }
  .wheel__lbl b{ font-size: clamp(14px, 1.6vw, 19px); font-weight: 900; letter-spacing: -.3px; }
  .wheel__lbl i{ font-style: normal; font-size: 10.5px; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; margin-top: 4px; color: rgba(255,255,255,.85); }
  .wheel__lbl--none b{ font-size: clamp(24px, 3vw, 36px); letter-spacing: -1px; }
  .wheel__cap{
    font-size: 13px;
    font-weight: 600;
    line-height: 1.5;
    color: rgba(255,255,255,.88);
    text-align: center;
    max-width: 40ch;
  }
  .wheel__key{
    list-style: none;
    margin: 0; padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 14px;
    font-size: 12px;
    font-weight: 700;
    color: rgba(255,255,255,.8);
  }
  .wheel__key li{ display: inline-flex; align-items: center; gap: 6px; }
  .wheel__sw{ width: 11px; height: 11px; border-radius: 3px; box-shadow: inset 0 0 0 1px rgba(255,255,255,.35); }
  .wheel__sw.is-hair{ width: 3px; border-radius: 2px; }

  /* ============================================================
     2. THE ODDS
     ============================================================ */
  .odds{ background: var(--violet); }
  .odds__lede{ margin-top: 18px; color: rgba(255,255,255,.88); }

  .table{ margin-top: clamp(30px, 4vw, 46px); }
  .table__head, .row{
    display: grid;
    grid-template-columns: minmax(120px, 190px) 1fr minmax(110px, 150px);
    column-gap: clamp(14px, 2.4vw, 32px);
    align-items: center;
  }
  .table__head{
    padding-bottom: 12px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: rgba(255,255,255,.7);
  }
  .table__head-pct{ text-align: right; }

  .row{
    padding: clamp(12px, 1.5vw, 18px) 0;
    border-top: 1px solid var(--line);
  }
  .row:last-child{ border-bottom: 1px solid var(--line); }
  .row__amt{ display: flex; flex-direction: column; gap: 3px; }
  .row__num{
    font-size: clamp(22px, 2.8vw, 34px);
    font-weight: 900;
    letter-spacing: -.8px;
    line-height: 1;
    color: var(--gold);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .row__num :global(.usdc){ vertical-align: -.08em; }
  .is-none .row__num{ color: rgba(255,255,255,.7); }
  .is-jackpot .row__num{ color: var(--pink-lite); text-shadow: 0 4px 22px rgba(255,127,176,.5); }
  .row__note{
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--pink-lite);
  }

  .row__track{
    height: clamp(26px, 3vw, 36px);
    border-radius: 999px;
    background: rgba(0,0,0,.16);
    overflow: hidden;
  }
  .row__bar{
    display: block;
    height: 100%;
    width: var(--w);
    min-width: 4px;
    border-radius: 999px;
    background: var(--c);
    box-shadow: inset 0 2px 0 rgba(255,255,255,.35), inset 0 -3px 0 rgba(0,0,0,.14);
  }
  .is-none .row__bar{ background: rgba(255,255,255,.28); }
  .is-jackpot .row__bar{ box-shadow: 0 0 10px rgba(240,83,143,.9); }

  .row__pct{ display: flex; flex-direction: column; align-items: flex-end; gap: 3px; text-align: right; }
  .row__big{
    font-size: clamp(20px, 2.6vw, 32px);
    font-weight: 900;
    letter-spacing: -.6px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .row__exact{ font-size: 12.5px; font-weight: 700; color: rgba(255,255,255,.7); font-variant-numeric: tabular-nums; }
  .is-jackpot .row__big{ color: var(--pink-lite); }

  .odds__foot{
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin-top: clamp(18px, 2.4vw, 26px);
    padding: 15px clamp(16px, 2vw, 20px);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(255,255,255,.08);
    font-size: clamp(15px, 1.6vw, 18px);
    font-weight: 600;
    color: rgba(255,255,255,.88);
  }
  .odds__foot strong{ color: #fff; font-weight: 900; }
  .odds__foot strong :global(.usdc){ vertical-align: -.14em; }
  .odds__sep{ color: rgba(255,255,255,.45); }
  .odds__scale{ margin-top: 12px; font-size: 12.5px; font-weight: 600; color: rgba(255,255,255,.62); }

  /* ============================================================
     3. HOW IT WORKS — numerals on a rail
     ============================================================ */
  .how{ background: var(--sky); }
  .steps{
    list-style: none;
    margin: clamp(34px, 5vw, 56px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(20px, 3vw, 40px);
  }
  .step{ position: relative; padding-left: clamp(16px, 2vw, 24px); }
  .step::before{
    content: '';
    position: absolute;
    left: 0; top: 4px; bottom: 4px;
    width: 3px;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--gold-lite), var(--gold-deep));
  }
  .step__n{
    display: block;
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -1.5px;
    color: transparent;
    -webkit-text-stroke: 2px rgba(255,255,255,.55);
    margin-bottom: 12px;
  }
  .step__t{ font-size: clamp(19px, 2vw, 23px); margin-bottom: 8px; }
  .step__x{ color: rgba(255,255,255,.88); font-size: 14.5px; line-height: 1.6; font-weight: 500; max-width: 30ch; }

  .rollout{
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(18px, 3vw, 34px);
    flex-wrap: wrap;
    margin-top: clamp(34px, 4.6vw, 56px);
    padding: clamp(20px, 2.6vw, 28px) clamp(20px, 2.6vw, 30px);
    border: 1px solid rgba(255,201,60,.55);
    border-radius: var(--radius);
    background: rgba(255,201,60,.1);
  }
  .rollout__txt{ flex: 1 1 420px; }
  .rollout__t{ font-size: clamp(18px, 2vw, 23px); font-weight: 900; letter-spacing: -.3px; margin-bottom: 7px; color: var(--gold-lite); }
  .rollout__x{ font-size: 14.5px; font-weight: 600; line-height: 1.6; color: rgba(255,255,255,.92); max-width: 62ch; }
  .rollout__cta{ flex: none; }

  /* ============================================================
     4. THE FREE SKIN, and the fine print
     ============================================================ */
  .skin{
    background:
      radial-gradient(900px 520px at 50% 40%, rgba(255,127,176,.30), transparent 60%),
      radial-gradient(760px 420px at 50% 80%, rgba(255,201,60,.16), transparent 62%),
      var(--violet);
  }
  .card{
    display: grid;
    grid-template-columns: minmax(200px, 340px) 1fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    padding: clamp(22px, 3vw, 40px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(180deg, rgba(255,255,255,.1), rgba(255,255,255,.04));
    box-shadow: 0 18px 48px rgba(30,14,80,.28);
  }
  .char{
    position: relative;
    margin: 0;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  .char__glow{
    position: absolute;
    inset: 10% 2%;
    border-radius: 50%;
    background:
      radial-gradient(58% 52% at 50% 60%, rgba(255,127,176,.55), transparent 70%),
      radial-gradient(42% 38% at 50% 78%, rgba(255,201,60,.42), transparent 72%);
    filter: blur(6px);
  }
