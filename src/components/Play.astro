---
import Divider from './Divider.astro';
import Usdc from './Usdc.astro';
import T from './T.astro';
import {
  DEPOSIT_MIN, WITHDRAW_MIN, TABLES, GAME_URL, PLAY_LABEL, NETWORK, CHAIN,
  WALLETS, SKIN,
} from '../data/site';

// The closing section. It was the whitelist form — an email in exchange for a
// promise. The game is deployed, so the promise is gone and the page ends on
// the door instead: what you need, what it costs, and one button.
const ledger = [
  {
    k: 'You need',
    v: 'an account',
    unit: false,
    x: `An email and a password on the first screen — or your wallet, if you have one: ${WALLETS.join(', ')}. No card, no download.`,
  },
  {
    k: 'You deposit from',
    v: `${DEPOSIT_MIN}`,
    unit: true,
    x: `In {USDC}, from ${WALLETS.join(', ')}: straight from your wallet in the lobby, or sent to your own game address.`,
  },
  {
    k: 'You stake',
    v: `${TABLES[0]}–${TABLES[TABLES.length - 1]}`,
    unit: true,
    x: 'Charged when the match starts, not when it ends. A match you never start costs nothing.',
  },
  {
    k: 'You withdraw from',
    v: `${WITHDRAW_MIN}`,
    unit: true,
    x: 'The threshold, stated up front. Below it, the balance stays in play. No waiting period, not even for a first withdrawal.',
  },
];
---
<section class="section play" id="play">
  <Divider dir="left" color="var(--violet)" />
  <div class="wrap play__grid">

    <div class="play__offer-col">
      <p class="eyebrow">Play</p>

      <h2 class="play__offer">
        <span class="play__amount">{TABLES.join(' · ')}<Usdc size=".68em" /></span>
        <span class="play__offer-txt">tables, open now</span>
      </h2>

      <p class="play__lead">
        Duels start at two players, squads at four, the arena at sixteen.
        It runs in the browser — nothing to install.
      </p>

      <dl class="ledger">
        {ledger.map((l) => (
          <div class="ledger__row">
            <dt class="ledger__k">{l.k}</dt>
            <dd class="ledger__v">
              <span class={`ledger__num ${l.unit ? '' : 'is-word'}`}>{l.v}{l.unit && <Usdc />}</span>
              <span class="ledger__x"><T text={l.x} /></span>
            </dd>
          </div>
        ))}
      </dl>

      <p class="play__note">
        <!-- Le logomark Solana, comme le pied de la porte du jeu : meme information,
             meme signe. -->
        <img class="play__mark" src="/icons/solana.svg" alt=""
             width="398" height="312" loading="lazy" decoding="async" />
        <span>
          <strong>{CHAIN} · {NETWORK}</strong> — real <Usdc />, real money. To play you
          need an account, {DEPOSIT_MIN} <Usdc /> or more in your game wallet, and a
          browser. Every match is a transaction you can open in the Solana explorer.
        </span>
      </p>
    </div>

    <div class="play__cta-col">
      <div class="play__card">
        <!-- Il DEBORDE du haut de la carte, il n'y est pas colle : pose dans le
             cadre il aurait eu l'air d'une vignette de catalogue. Il pointe vers
             le lecteur, donc il regarde du bon cote d'un appel a l'inscription. -->
        <figure class="skin">
          <span class="skin__glow" aria-hidden="true"></span>
          <span class="skin__flash">Free</span>
          <img
            class="skin__img"
            src={SKIN.image}
            alt={`${SKIN.name} — ${SKIN.who}, as a playable character`}
            width="632" height="760"
            loading="lazy" decoding="async"
          />
        </figure>

        <p class="skin__name">{SKIN.name}</p>

        <p class="play__card-title">
          <span class="play__card-free">Free skin</span> when you sign up.
        </p>

        <p class="play__card-txt">
          {SKIN.who}, in a diaper. A gift box is waiting on your first visit to the
          lobby — open it and he is yours, equipped. The only character in the game
          you do not have to earn or buy.
        </p>

        <a class="btn btn--gold btn--lg play__submit" href={GAME_URL}>{PLAY_LABEL}</a>

        <p class="form-note">
          Opens play.babyguy.xyz. 18+ — a match can cost you your entire stake.
        </p>
      </div>
    </div>

  </div>
</section>

<style>
  .play{
    /* The glows stay centred: touching an edge would leave a seam where the
       colour no longer matches the divider. */
    background:
      radial-gradient(900px 520px at 50% 46%, rgba(255,127,176,.30), transparent 60%),
      radial-gradient(760px 420px at 50% 74%, rgba(255,201,60,.16), transparent 62%),
      var(--violet);
  }

  /* Offer on the left, the door on the right — a centred stack made the section
     a full screen tall for one button. */
  .play__grid{
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .play__offer{ display: flex; flex-direction: column; gap: 2px; margin-bottom: 18px; }
  /* The coin aligns to the digit, not to the body text. */
  .play__amount :global(.usdc){ vertical-align: -.01em; margin-inline: .16em 0; }
  .play__amount{
    font-size: clamp(46px, 6.6vw, 88px);
    font-weight: 900;
    letter-spacing: -3px;
    line-height: .95;
    color: var(--gold);
    text-shadow: 0 8px 40px rgba(255,201,60,.28);
  }
  .play__offer-txt{
    font-size: clamp(16px, 2vw, 23px);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .play__lead{
    font-size: clamp(15px, 1.7vw, 18px);
    font-weight: 600;
    line-height: 1.55;
    color: #fff;
    max-width: 46ch;
  }

  /* --- The ledger: three lines, no prose to hunt through --- */
  .ledger{ margin: clamp(24px, 3vw, 34px) 0 0; padding: 0; }
  .ledger__row{
    display: grid;
    grid-template-columns: minmax(120px, 168px) 1fr;
    gap: clamp(12px, 2vw, 24px);
    align-items: baseline;
    padding: clamp(14px, 1.8vw, 18px) 0;
    border-top: 1px solid var(--line);
  }
  .ledger__row:last-child{ border-bottom: 1px solid var(--line); }
  .ledger__k{
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: rgba(255,255,255,.88);
  }
  .ledger__v{ margin: 0; display: flex; flex-direction: column; gap: 5px; }
  .ledger__num{
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 900;
    letter-spacing: -.8px;
    line-height: 1;
    color: var(--gold);
  }
  .ledger__num.is-word{ font-size: clamp(20px, 2.4vw, 26px); }
  .ledger__x{
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.55;
    color: rgba(255,255,255,.88);
    max-width: 46ch;
  }

  /* The mainnet notice. Same pill as the devnet notice before it (and the old
     scarcity line before that), and it says the one thing a visitor about to
     stake needs to know before clicking: this is real money. */
  .play__note{
    margin-top: clamp(22px, 3vw, 30px);
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 13px 20px;
    border: 1px solid rgba(20,241,149,.45);
    border-radius: 14px;
    background: rgba(20,241,149,.09);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.55;
    color: #fff;
    max-width: 56ch;
  }
  .play__note strong{ color: #CCFF00; font-weight: 900; text-transform: uppercase; letter-spacing: .6px; }
  .play__mark{
    flex: none;
    margin-top: 3px;
    width: auto;
    height: 15px;
  }

  /* --- The door, in a card of the same stock as the rest of the site --- */
  /* Le personnage sort du cadre par le haut, donc la colonne lui reserve la
     place au-dessus de la carte — sinon il passait sous la section precedente. */
  .play__cta-col{ position: sticky; top: 96px; padding-top: clamp(96px, 12vw, 178px); }
  .play__card{
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(22px, 3vw, 34px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(180deg, rgba(255,255,255,.1), rgba(255,255,255,.04));
    box-shadow: 0 18px 48px rgba(30,14,80,.28);
  }

  /* ============================================================
     LE SKIN. La lueur derriere lui reprend les deux radiales de la
     section — c'est ce qui le pose DANS le decor au lieu de le coller
     dessus : le meme rose et le meme or, en plus serre.
     ============================================================ */
  .skin{
    position: relative;
    /* Le debordement vaut la moitie de sa hauteur, et la colonne reserve
       autant au-dessus : les deux valeurs bougent ENSEMBLE ou il passe sous
       la section precedente. */
    margin: clamp(-172px, -11.5vw, -92px) auto 2px;
    width: min(84%, 332px);
    aspect-ratio: 632 / 760;
    display: grid;
    place-items: end center;
  }
  .skin__glow{
    position: absolute;
    inset: 8% -22% -6%;
    border-radius: 50%;
    background:
      radial-gradient(58% 52% at 50% 62%, rgba(255,127,176,.55), transparent 70%),
      radial-gradient(42% 38% at 50% 78%, rgba(255,201,60,.42), transparent 72%);
    filter: blur(6px);
  }
  .skin__img{
    position: relative;
    width: 100%;
    height: auto;
    /* Une ombre portee au sol : sans elle il flotte. */
    filter: drop-shadow(0 16px 22px rgba(28,12,70,.55));
  }
  /* La pastille FREE, posee de biais sur son epaule pointee. */
  .skin__flash{
    position: absolute;
    top: 13%; left: -6%;
    z-index: 2;
    transform: rotate(-11deg);
    padding: 8px 18px;
    border-radius: 999px;
    background: linear-gradient(180deg, var(--gold-lite) 0%, var(--gold) 52%, var(--gold-deep) 100%);
    color: var(--violet-ink);
    font-size: clamp(13px, 1.5vw, 17px);
    font-weight: 900;
    letter-spacing: 1.3px;
    text-transform: uppercase;
    box-shadow: inset 0 2px 0 rgba(255,255,255,.6), 0 6px 16px rgba(120,70,0,.35);
  }
  .skin__name{
    text-align: center;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 2.2px;
    text-transform: uppercase;
    color: var(--gold);
  }
  .play__card-title{
    text-align: center;
    font-size: clamp(21px, 2.4vw, 28px);
    font-weight: 900;
    letter-spacing: -.5px;
    line-height: 1.12;
    margin-bottom: 2px;
  }
  .play__card-free{ color: var(--gold); }
  .play__card-txt{
    text-align: center;
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.55;
    color: rgba(255,255,255,.88);
  }
  .play__card .form-note{ color: rgba(255,255,255,.88); }
  .play__submit{ width: 100%; margin-top: 8px; text-align: center; }

  @media (max-width: 900px){
    .play__grid{ grid-template-columns: 1fr; gap: clamp(30px, 6vw, 44px); }
    /* Empilee, la colonne n'a plus de section au-dessus a chevaucher : le
       personnage tient dans la carte et la reserve de place n'a plus lieu. */
    .play__cta-col{ position: static; padding-top: clamp(58px, 16vw, 104px); }
    .skin{ margin-top: clamp(-104px, -16vw, -58px); width: min(74%, 268px); }
    .ledger__x{ max-width: 60ch; }
  }
  @media (max-width: 480px){
    .ledger__row{ grid-template-columns: 1fr; gap: 8px; }
  }
</style>
