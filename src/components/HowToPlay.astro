---
import Divider from './Divider.astro';
import Usdc from './Usdc.astro';
import T from './T.astro';
import Formats from './Formats.astro';
import { steps, payouts, TABLE_STAKE, PLAYERS, COMMISSION_PCT, POT } from '../data/site';

// The chart is scaled to the biggest prize, so the bars stay honest if the
// payout table in site.ts ever changes.
const top = Math.max(...payouts.map((p) => parseFloat(p.gain) || 0));
const rows = payouts.map((p) => {
  const gain = parseFloat(p.gain) || 0;
  return { ...p, gain, pct: (gain / top) * 100, none: gain === 0 };
});

// Where the stake sits on that same scale — the break-even line.
const stakeAt = (TABLE_STAKE / top) * 100;

// The four numbers describe the ARENA — the biggest table, and the one the
// chart above charts. Saying "16 players" flat would contradict the formats
// block three inches higher.
const facts = [
  { v: `${TABLE_STAKE}`, unit: true,  k: 'per seat' },
  { v: `${PLAYERS}`,     unit: false, k: 'seats in an arena' },
  { v: '3',              unit: false, k: 'arena rounds, maps drawn at random' },
  { v: `${POT}`,         unit: true,  k: 'in the pot' },
];
---
<section class="section how" id="the-game">
  <Divider dir="right" color="var(--violet)" />
  <div class="wrap">
    <p class="eyebrow">How it works</p>
    <h2 class="h2">Three beats, no grey areas.</h2>

    <!-- The three beats: numerals on a rail, not cards. -->
    <ol class="steps">
      {steps.map((s) => (
        <li class="step">
          <span class="step__n" aria-hidden="true">{s.n}</span>
          <h3 class="step__t">{s.title}</h3>
          <p class="step__x"><T text={s.text} /></p>
        </li>
      ))}
    </ol>

    <!-- The three formats. It sits here and not lower: the chart underneath is
         the arena's, and sixteen rows read as "the game" unless you have just
         been told the arena is one table out of three. -->
    <Formats />

    <!-- The prize table, drawn to scale. The stake line is the whole point:
         everything that reaches it walks away whole. -->
    <figure class="prize">
      <figcaption class="prize__head">
        <h3 class="prize__title">What each place pays in the arena</h3>
        <p class="prize__ctx">
          {PLAYERS} players · on a {TABLE_STAKE}<Usdc /> table · {COMMISSION_PCT}% commission · {POT}<Usdc /> pot
        </p>
      </figcaption>

      <div class="chart" style={`--at:${stakeAt}%`}>
        {rows.map((p, i) => (
          <>
            <p class="chart__rank" style={`--row:${i + 1}`}>
              {p.rank}{!p.none && <span class="chart__mult-alt">{p.mult}</span>}
            </p>

            <div class="chart__track" style={`--row:${i + 1}`}>
              {p.none ? (
                <span class="chart__empty">nothing</span>
              ) : (
                <span
                  class={`chart__bar ${p.highlight ? 'is-even' : 'is-profit'}`}
                  style={`--w:${p.pct}%`}
                >
                  <span class="chart__mult">{p.mult}</span>
                </span>
              )}
            </div>

            <p class={`chart__gain ${p.none ? 'is-none' : ''}`} style={`--row:${i + 1}`}>
              {p.none ? '0' : p.gain.toFixed(2)}<Usdc />
            </p>
          </>
        ))}
      </div>

      <p class="prize__key">
        <span class="prize__key-mark" aria-hidden="true"></span>
        <span class="prize__key-txt">
          The line is your stake. <strong>Everything that reaches it, you keep.</strong>
          The top eight lose nothing — 5th to 8th get exactly their {TABLE_STAKE}<Usdc /> back.
        </span>
      </p>
    </figure>

    <!-- The match, in four numbers. -->
    <ul class="facts">
      {facts.map((f) => (
        <li class="fact">
          <span class="fact__v">{f.v}{f.unit && <Usdc />}</span>
          <span class="fact__k">{f.k}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .how{ background: var(--violet); }

  /* ============================================================
     THE THREE BEATS — numerals on a rail. No boxes: the Token
     section owns the boxed look, this one owns the numerals.
     ============================================================ */

  .steps{
    list-style: none;
    margin: clamp(34px, 5vw, 56px) 0 clamp(44px, 6vw, 74px);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3vw, 44px);
  }
  .step{ position: relative; padding-left: clamp(18px, 2.4vw, 30px); }
  .step::before{
    content: '';
    position: absolute;
    left: 0; top: 4px; bottom: 4px;
    width: 3px;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--gold-lite), var(--gold-deep));
  }
  .step__n{
    display: block;
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -1.5px;
    color: transparent;
    -webkit-text-stroke: 2px rgba(255,255,255,.5);
    margin-bottom: 12px;
  }
  .step__t{ font-size: clamp(20px, 2.4vw, 26px); margin-bottom: 10px; }
  .step__x{
    color: rgba(255,255,255,.88);
    font-size: 15px;
    line-height: 1.6;
    font-weight: 500;
    max-width: 42ch;
  }

  /* ============================================================
     THE PRIZE CHART — the old table said it, this shows it.
     ============================================================ */

  .prize{ margin: 0; }
  .prize__head{ margin-bottom: clamp(20px, 2.6vw, 30px); }
  .prize__title{ font-size: clamp(21px, 2.4vw, 28px); }
  .prize__ctx{
    margin-top: 8px;
    font-size: 13.5px;
    font-weight: 600;
    color: rgba(255,255,255,.88);
  }

  .chart{
    display: grid;
    grid-template-columns: minmax(78px, 118px) 1fr minmax(84px, 108px);
    column-gap: clamp(12px, 1.8vw, 22px);
    align-items: center;
  }

  .chart__rank{
    grid-column: 1;
    grid-row: var(--row);
    font-size: 14px;
    font-weight: 800;
    color: rgba(255,255,255,.88);
    padding: 7px 0;
    white-space: nowrap;
  }

  .chart__track{
    grid-column: 2;
    grid-row: var(--row);
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    height: 38px;
    margin: 5px 0;
    border-radius: 999px;
    background: rgba(0,0,0,.16);
  }
  /* The stake line, drawn over the bars. Each track carries one segment and
     bleeds into its 5px margins, so the segments tile into a single line. */
  .chart__track::after{
    content: '';
    position: absolute;
    left: var(--at);
    top: -5px; bottom: -5px;
    width: 2px;
    margin-left: -1px;
    z-index: 2;
    pointer-events: none;
    background: repeating-linear-gradient(
      180deg,
      rgba(255,255,255,.9) 0 7px,
      transparent 7px 13px
    );
  }

  .chart__bar{
    flex: 0 0 var(--w);
    min-width: 54px;          /* keeps the multiplier readable on short bars */
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 12px;
    border-radius: 999px;
    overflow: hidden;
  }
  /* Same glossy stock as .btn--gold — gold means "you made money". */
  .chart__bar.is-profit{
    background: linear-gradient(180deg, var(--gold-lite) 0%, var(--gold) 52%, var(--gold-deep) 100%);
    box-shadow: inset 0 2px 0 rgba(255,255,255,.6), inset 0 -3px 0 rgba(170,100,0,.26);
    color: var(--violet-ink);
  }
  /* Break-even is not a win. Same material, no gold. */
  .chart__bar.is-even{
    background: linear-gradient(180deg, rgba(255,255,255,.42), rgba(255,255,255,.2));
    box-shadow: inset 0 2px 0 rgba(255,255,255,.5), inset 0 -3px 0 rgba(0,0,0,.14);
    color: #fff;
  }
  .chart__mult{ font-size: 12.5px; font-weight: 800; letter-spacing: .2px; white-space: nowrap; }
  /* Desktop puts the multiplier in the bar; narrow screens put it by the rank. */
  .chart__mult-alt{ display: none; }

  .chart__empty{
    padding-left: 14px;
    font-size: 12.5px;
    font-weight: 700;
    color: rgba(255,255,255,.55);
  }

  .chart__gain{
    grid-column: 3;
    grid-row: var(--row);
    text-align: right;
    font-size: clamp(14px, 1.5vw, 16px);
    font-weight: 900;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .chart__gain.is-none{ color: rgba(255,255,255,.45); font-weight: 700; }

  .prize__key{
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: clamp(18px, 2.4vw, 26px);
    padding: 15px clamp(16px, 2vw, 20px);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(255,255,255,.08);
    font-size: 14px;
    line-height: 1.6;
    font-weight: 500;
    color: rgba(255,255,255,.88);
  }
  .prize__key-txt{ flex: 1; }
  .prize__key strong{ color: #fff; font-weight: 800; }
  .prize__key-mark{
    flex: none;
    align-self: stretch;
    width: 2px;
    border-radius: 2px;
    background: repeating-linear-gradient(
      180deg,
      rgba(255,255,255,.85) 0 7px,
      transparent 7px 13px
    );
  }

  /* ============================================================
     THE MATCH IN FOUR NUMBERS — replaces the gameplay loop.
     ============================================================ */

  .facts{
    list-style: none;
    margin: clamp(30px, 4vw, 48px) 0 0;
    padding: clamp(20px, 2.6vw, 28px) 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(16px, 2.4vw, 30px);
  }
  .fact{ display: flex; flex-direction: column; gap: 5px; }
  .fact__v{
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 900;
    letter-spacing: -.8px;
    line-height: 1;
    color: var(--gold);
  }
  .fact__k{ font-size: 13px; font-weight: 600; color: rgba(255,255,255,.88); }

  /* ============================================================
     RESPONSIVE
     ============================================================ */

  @media (max-width: 900px){
    .steps{ grid-template-columns: 1fr; gap: clamp(22px, 4vw, 30px); }
    .step__x{ max-width: 60ch; }
    .facts{ grid-template-columns: repeat(2, 1fr); row-gap: clamp(20px, 4vw, 26px); }
  }

  @media (max-width: 620px){
    /* The rank moves above its bar so the track keeps a usable width
       instead of the table's old sideways scroll. */
    .chart{ grid-template-columns: 1fr auto; column-gap: 12px; }
    /* Each place now takes two rows: label line, then its bar. */
    .chart__rank{ grid-column: 1; grid-row: calc(var(--row) * 2 - 1); align-self: end; padding: 0 0 2px; font-size: 13px; }
    .chart__mult{ display: none; }
    .chart__mult-alt{
      display: inline;
      margin-left: 7px;
      font-size: 12px;
      font-weight: 700;
      color: rgba(255,255,255,.62);
    }
    .chart__gain{ grid-column: 2; grid-row: calc(var(--row) * 2 - 1); align-self: end; padding-bottom: 2px; }
    .chart__track{ grid-column: 1 / -1; grid-row: calc(var(--row) * 2); height: 34px; margin: 0 0 14px; }
    /* On mobile the rank sits above each bar, so the line only bridges the bar gap. */
    .chart__track::after{ top: 0; bottom: -14px; }
  }
</style>
